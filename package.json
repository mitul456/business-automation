{
  "name": "omniflow-saas",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow AI - Enterprise AI Business Automation SaaS Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @omniflow/database db:generate",
    "db:push": "pnpm --filter @omniflow/database db:push",
    "db:seed": "pnpm --filter @omniflow/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
