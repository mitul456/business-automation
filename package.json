{
  "name": "omniflow-saas",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow AI - Enterprise AI Business Automation SaaS Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @omniflow/database db:generate",
    "db:push": "pnpm --filter @omniflow/database db:push",
    "db:migrate:dev": "pnpm --filter @omniflow/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @omniflow/database db:migrate:deploy",
    "db:seed": "pnpm --filter @omniflow/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
