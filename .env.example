# ==============================================================================
# OmniFlow AI — Enterprise Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting development.
# Sensitive production secrets must never be committed to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-character secret string used for AES-256-GCM token encryption at rest
ENCRYPTION_SECRET=omniflow-default-32-byte-secret-key-1234
# Secret key used for signing JWT access tokens
JWT_SECRET=omniflow-dev-jwt-super-secret-key-4321
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# MySQL relational database connection URL
DATABASE_URL=mysql://omniflow:omniflow_pass@localhost:3306/omniflow_db
# Redis 7 connection URL for BullMQ background queues & caching
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. S3 / OBJECT STORAGE (MINIO OR AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=omniflow-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. OPENAI & MULTIMODAL AI INTELLIGENCE
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-placeholder-for-development
DEFAULT_AI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. META GRAPH API (MESSENGER & INSTAGRAM)
# ------------------------------------------------------------------------------
META_APP_ID=123456789012345
META_APP_SECRET=placeholder_meta_app_secret_here
META_VERIFY_TOKEN=omniflow_webhook_verify_token_2026

# ------------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
WA_PHONE_NUMBER_ID=109283746500000
WA_BUSINESS_ACCOUNT_ID=209384756100000
WA_SYSTEM_USER_ACCESS_TOKEN=placeholder_whatsapp_permanent_token

# ------------------------------------------------------------------------------
# 8. BANGLADESHI PAYMENT GATEWAYS (BKASH & NAGAD)
# ------------------------------------------------------------------------------
# bKash Tokenized Checkout v1.2.0-beta
BKASH_APP_KEY=placeholder_bkash_app_key
BKASH_APP_SECRET=placeholder_bkash_app_secret
BKASH_USERNAME=01700000000
BKASH_PASSWORD=placeholder_bkash_password
BKASH_IS_SANDBOX=true

# Nagad Direct PG v1.0
NAGAD_MERCHANT_ID=placeholder_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
NAGAD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
NAGAD_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# 9. GLOBAL PAYMENT GATEWAY (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# 10. BANGLADESHI COURIER LOGISTICS (STEADFAST & PATHAO)
# ------------------------------------------------------------------------------
# Steadfast Courier API v1
STEADFAST_API_KEY=demo_steadfast_key_xyz
STEADFAST_SECRET_KEY=demo_steadfast_secret_xyz

# Pathao Courier Aladdin API v1
PATHAO_CLIENT_ID=placeholder_pathao_client_id
PATHAO_CLIENT_SECRET=placeholder_pathao_client_secret
PATHAO_USERNAME=merchant@example.com
PATHAO_PASSWORD=placeholder_pathao_password
PATHAO_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# 11. INITIAL SUPER-ADMIN SEEDING
# ------------------------------------------------------------------------------
INITIAL_SUPERADMIN_EMAIL=admin@omniflow.ai
INITIAL_SUPERADMIN_PASSWORD=Admin123!
