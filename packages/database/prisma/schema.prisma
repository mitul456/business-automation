generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  SALES_AGENT
  SUPPORT_AGENT
  VIEWER
  AGENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CreditTransactionType {
  SUBSCRIPTION_GRANT
  TOPUP_PURCHASE
  BONUS
  USAGE_CHAT
  USAGE_VISION
  USAGE_VOICE
  USAGE_EMBEDDING
  REFUND
  ADMIN_ADJUSTMENT
  TRIAL_GRANT
}

enum ChannelType {
  FACEBOOK_PAGE
  INSTAGRAM
  WHATSAPP_BUSINESS
  LIVECHAT
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum ConversationStatus {
  OPEN
  BOT_ACTIVE
  HUMAN_HANDOVER
  SNOOZED
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SenderType {
  CUSTOMER
  AGENT
  BOT
  SYSTEM
}

enum MessageContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  PRODUCT_CARD
  ORDER_CARD
  TEMPLATE
}

enum DeliveryStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
  REJECTED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  STRIPE
  SSLCOMMERZ
}

enum PaymentProvider {
  BKASH
  NAGAD
  STRIPE
  SSLCOMMERZ
  MANUAL
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  MANUAL
}

enum ShipmentStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum AiTone {
  FRIENDLY
  PROFESSIONAL
  DIRECT
  PERSUASIVE
}

enum AiLanguage {
  AUTO
  BENGALI
  ENGLISH
  BANGLISH
}

enum DocSourceType {
  FAQ
  MANUAL_TEXT
  PDF_FILE
  DOCX_FILE
  TXT_FILE
  CSV_FILE
  URL_SCRAPE
  INSTRUCTIONS
}

enum DocStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum WorkflowTriggerType {
  NEW_MESSAGE
  NEW_CUSTOMER
  NEW_LEAD
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  BOOKING_CREATED
  INACTIVITY_TIMEOUT
  KEYWORD_DETECTED
  HUMAN_HANDOVER_REQUESTED
}

enum WorkflowActionType {
  SEND_MESSAGE
  ASSIGN_AGENT
  ADD_CUSTOMER_TAG
  CREATE_LEAD
  CREATE_ORDER_DRAFT
  SEND_NOTIFICATION
  SCHEDULE_FOLLOWUP
  ESCALATE_TO_HUMAN
  AI_GENERATE_REPLY
  UPDATE_LEAD_STAGE
  DISPATCH_COURIER_PARCEL
  TRIGGER_WEBHOOK
  WAIT_DELAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// -------------------------------------------------------------
// Multi-Tenant & RBAC Domain
// -------------------------------------------------------------

model Tenant {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  logo            String?
  category        String        @default("GENERAL_RETAIL")
  country         String        @default("BD")
  currency        String        @default("BDT")
  timezone        String        @default("Asia/Dhaka")
  defaultLanguage String        @default("bn")
  creditBalance   Int           @default(500)
  lowCreditThreshold Int        @default(100)
  monthlyUsageLimit  Int?
  businessSettings Json?
  status          TenantStatus  @default(TRIAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members              WorkspaceMember[]
  subscriptions        TenantSubscription[]
  creditTransactions   AiCreditTransaction[]
  aiUsageLogs          AiUsageLog[]
  auditLogs            AuditLog[]
  channels             Channel[]
  customers            Customer[]
  conversations        Conversation[]
  messages             Message[]
  aiAgentConfig        AiAgentConfig?
  knowledgeBases       KnowledgeBase[]
  knowledgeDocuments   KnowledgeDocument[]
  knowledgeChunks      KnowledgeChunk[]
  categories           Category[]
  products             Product[]
  orders               Order[]
  courierSettings      CourierSetting[]
  shipments            Shipment[]
  paymentIntegrations  PaymentIntegration[]
  paymentTransactions  PaymentTransaction[]
  workflows            Workflow[]
  workflowExecutions   WorkflowExecution[]
  bookingServices      BookingService[]
  bookingAppointments  BookingAppointment[]
  inventoryTransactions InventoryTransaction[]
  followUps            FollowUp[]
  customerTimelineEvents CustomerTimelineEvent[]
  creditTopupRequests  CreditTopupRequest[]

  @@index([status])
}

model User {
  id                         String        @id @default(uuid())
  email                      String        @unique
  passwordHash               String
  name                       String
  avatarUrl                  String?
  phone                      String?
  isSuperAdmin               Boolean       @default(false)
  emailVerified              Boolean       @default(false)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?
  passwordResetExpiresAt     DateTime?
  googleId                   String?
  status                     UserStatus    @default(ACTIVE)
  lastLoginAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  memberships                WorkspaceMember[]
  sessions                   UserSession[]
  auditLogs                  AuditLog[]
  creditTopupRequests        CreditTopupRequest[]

  @@index([email])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model WorkspaceMember {
  id                      String        @id @default(uuid())
  tenantId                String
  userId                  String
  role                    WorkspaceRole @default(AGENT)
  isOnline                Boolean       @default(false)
  activeConversationCount Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedConversations   Conversation[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model TenantSubscription {
  id                  String             @id @default(uuid())
  tenantId            String
  planTier            PlanTier           @default(STARTER)
  billingCycle        BillingCycle       @default(MONTHLY)
  status              TenantStatus       @default(ACTIVE)
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime
  stripeSubscriptionId String?
  bkashSubscriptionId  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AiCreditTransaction {
  id             String                @id @default(uuid())
  tenantId       String
  amount         Int
  type           CreditTransactionType
  balanceAfter   Int
  description    String
  idempotencyKey String?               @unique
  adminUserId    String?
  orderId        String?
  metadata       Json?
  createdAt      DateTime              @default(now())

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([idempotencyKey])
}

model AiUsageLog {
  id                String   @id @default(uuid())
  tenantId          String
  provider          String   @default("OPENAI")
  model             String
  operation         String   // CHAT, VISION, VOICE, EMBEDDING
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  providerCostUsd   Decimal  @default(0.0000) @db.Decimal(10, 4)
  providerCostBdt   Decimal  @default(0.00) @db.Decimal(10, 2)
  creditsDeducted   Int      @default(1)
  customerChargeBdt Decimal  @default(0.00) @db.Decimal(10, 2)
  idempotencyKey    String?  @unique
  conversationId    String?
  messageId         String?
  metadata          Json?
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([provider, createdAt])
  @@index([operation])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// -------------------------------------------------------------
// Omnichannel Messaging Domain
// -------------------------------------------------------------

model Channel {
  id                    String        @id @default(uuid())
  tenantId              String
  type                  ChannelType
  name                  String
  externalId            String
  accessTokenEncrypted  String?       @db.Text
  refreshTokenEncrypted String?       @db.Text
  webhookVerifyToken    String?
  status                ChannelStatus @default(CONNECTED)
  config                Json?
  lastSyncedAt          DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  orders                Order[]

  @@unique([tenantId, type, externalId])
  @@index([tenantId])
}

model Customer {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  email       String?
  phone       String?
  avatarUrl   String?
  city        String?
  district    String?
  address     String?     @db.Text
  leadStage   LeadStage   @default(NEW)
  leadScore   Int         @default(50)
  assignedMemberId String?
  tags        Json?
  notes       String?     @db.Text
  totalOrders Int         @default(0)
  totalSpent  Decimal     @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations       Conversation[]
  orders              Order[]
  bookingAppointments BookingAppointment[]
  followUps           FollowUp[]
  timelineEvents      CustomerTimelineEvent[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Conversation {
  id                 String             @id @default(uuid())
  tenantId           String
  channelId          String
  customerId         String
  assignedMemberId   String?
  status             ConversationStatus @default(BOT_ACTIVE)
  priority           Priority           @default(MEDIUM)
  lastMessagePreview String?            @db.Text
  lastMessageAt      DateTime           @default(now())
  unreadCount        Int                @default(0)
  aiAssisted         Boolean            @default(true)
  tags               Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel            Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedMember     WorkspaceMember?   @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]
  bookingAppointments BookingAppointment[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([channelId])
  @@index([customerId])
}

model Message {
  id                String             @id @default(uuid())
  tenantId          String
  conversationId    String
  senderType        SenderType
  senderId          String?
  contentType       MessageContentType @default(TEXT)
  content           String             @db.Text
  mediaUrl          String?            @db.Text
  mediaMetadata     Json?
  externalMessageId String?
  deliveryStatus    DeliveryStatus     @default(SENT)
  aiGenerated       Boolean            @default(false)
  isInternal        Boolean            @default(false)
  tokensUsed        Int?
  sentiment         String?
  createdAt         DateTime           @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, createdAt])
  @@index([externalMessageId])
}

// -------------------------------------------------------------
// AI Agent & Knowledge Base Domain
// -------------------------------------------------------------

model AiAgentConfig {
  id                  String     @id @default(uuid())
  tenantId            String     @unique
  personaName         String     @default("OmniAssistant")
  systemPrompt        String     @db.Text
  tone                AiTone     @default(FRIENDLY)
  language            AiLanguage @default(AUTO)
  temperature         Float      @default(0.7)
  confidenceThreshold Float      @default(0.75)
  capabilities        Json
  handoverKeywords    Json
  fallbackMessageEn   String     @db.Text
  fallbackMessageBn   String     @db.Text
  businessHoursOnly   Boolean    @default(false)
  businessHoursJson   Json?
  businessIdentity    String?    @db.Text
  personality         String?    @default("Helpful, polite and sales-oriented")
  escalationRules     Json?
  knowledgeSourceIds  Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id          String              @id @default(uuid())
  tenantId    String
  name        String
  description String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]

  @@index([tenantId])
}

model KnowledgeDocument {
  id              String         @id @default(uuid())
  knowledgeBaseId String
  tenantId        String
  title           String
  sourceType      DocSourceType  @default(FAQ)
  sourceUrl       String?        @db.Text
  status          DocStatus      @default(PENDING)
  chunkCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([tenantId])
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  tenantId   String
  content    String            @db.Text
  embedding  Json
  metadata   Json?
  tokenCount Int               @default(0)
  createdAt  DateTime          @default(now())

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([tenantId])
}

// -------------------------------------------------------------
// E-Commerce, Catalog, Orders & Delivery
// -------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
}

model Product {
  id             String        @id @default(uuid())
  tenantId       String
  categoryId     String?
  name           String
  sku            String
  description    String?       @db.Text
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  costPrice      Decimal?      @db.Decimal(12, 2)
  stockQuantity      Int           @default(0)
  lowStockThreshold  Int           @default(5)
  variants           Json?
  images             Json
  visualTags         Json?
  status             ProductStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
}

model Order {
  id                 String        @id @default(uuid())
  tenantId           String
  orderNumber        String
  customerId         String
  conversationId     String?
  channelId          String?
  status             OrderStatus   @default(PENDING)
  subtotal           Decimal       @db.Decimal(12, 2)
  shippingCost       Decimal       @default(0.00) @db.Decimal(12, 2)
  discount           Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  currency           String        @default("BDT")
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      PaymentMethod @default(COD)
  shippingAddress    Json
  notes              String?       @db.Text
  idempotencyKey     String?       @unique
  courierName        String?
  courierTrackingId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation       Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  channel            Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  shipments          Shipment[]
  transactions       PaymentTransaction[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  totalPrice  Decimal  @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model CourierSetting {
  id                 String          @id @default(uuid())
  tenantId           String
  provider           CourierProvider
  apiKeyEncrypted    String          @db.Text
  secretKeyEncrypted String?         @db.Text
  isActive           Boolean         @default(true)
  isDefault          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Shipment {
  id             String          @id @default(uuid())
  tenantId       String
  orderId        String
  courier        CourierProvider
  consignmentId  String?
  trackingCode   String?
  status         ShipmentStatus  @default(PENDING)
  pickupAddress  Json?
  deliveryFee    Decimal         @default(0.00) @db.Decimal(12, 2)
  codAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  rawResponse    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
}

model PaymentIntegration {
  id                 String          @id @default(uuid())
  tenantId           String
  provider           PaymentProvider
  merchantId         String?
  apiKeyEncrypted    String          @db.Text
  secretKeyEncrypted String          @db.Text
  isActive           Boolean         @default(true)
  isSandbox          Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PaymentTransaction {
  id               String          @id @default(uuid())
  tenantId         String
  orderId          String
  provider         PaymentProvider
  transactionId    String
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("BDT")
  status           PaymentStatus   @default(UNPAID)
  providerResponse Json?
  verifiedAt       DateTime?
  createdAt        DateTime        @default(now())

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([transactionId])
}

// -------------------------------------------------------------
// Workflows & Appointments
// -------------------------------------------------------------

model Workflow {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  description   String?             @db.Text
  triggerType   WorkflowTriggerType
  triggerConfig Json
  graphJson     Json?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps         WorkflowStep[]
  executions    WorkflowExecution[]

  @@index([tenantId])
}

model WorkflowExecution {
  id           String    @id @default(uuid())
  tenantId     String
  workflowId   String
  status       String    @default("SUCCESS")
  triggerEvent String
  contextData  Json?
  stepResults  Json?
  errorMessage String?   @db.Text
  retryCount   Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId, startedAt])
}

model WorkflowStep {
  id           String             @id @default(uuid())
  workflowId   String
  stepOrder    Int
  actionType   WorkflowActionType
  actionConfig Json

  workflow     Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model BookingService {
  id              String               @id @default(uuid())
  tenantId        String
  name            String
  description     String?              @db.Text
  durationMinutes Int                  @default(30)
  price           Decimal              @default(0.00) @db.Decimal(12, 2)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    BookingAppointment[]

  @@index([tenantId])
}

model BookingAppointment {
  id                 String         @id @default(uuid())
  tenantId           String
  serviceId          String
  customerId         String
  conversationId     String?
  scheduledStartTime DateTime
  scheduledEndTime   DateTime
  status             BookingStatus  @default(PENDING)
  customerNotes      String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service            BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, scheduledStartTime])
  @@index([customerId])
}

model InventoryTransaction {
  id             String   @id @default(uuid())
  tenantId       String
  productId      String
  quantityDelta  Int
  balanceAfter   Int
  type           String   // RESTOCK, ORDER_DEDUCTION, ORDER_CANCEL_RESTORE, MANUAL_ADJUSTMENT
  referenceId    String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

model FollowUp {
  id               String    @id @default(uuid())
  tenantId         String
  customerId       String
  assignedMemberId String?
  title            String
  notes            String?   @db.Text
  dueDate          DateTime
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate])
  @@index([customerId])
}

model CustomerTimelineEvent {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  eventType   String   // ORDER_CREATED, ORDER_STATUS_CHANGED, MESSAGE_RECEIVED, STAGE_CHANGED, NOTE_ADDED, APPOINTMENT_BOOKED
  title       String
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
}

// -------------------------------------------------------------
// Top-Up & Payment Management
// -------------------------------------------------------------

model CreditTopupRequest {
  id             String        @id @default(uuid())
  tenantId       String
  userId         String
  planId         String
  credits        Int
  amountBdt      Decimal       @db.Decimal(12, 2)
  paymentMethod  String
  status         PaymentStatus @default(PENDING)
  trxId          String?
  customerPhone  String?
  providerRef    String?
  adminNotes     String?       @db.Text
  approvedAt     DateTime?
  approvedBy     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([trxId])
}

model PaymentMethodConfig {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  type            String   @default("AUTOMATED")
  merchantNumber  String?
  instructions    String?  @db.Text
  apiKeyEncrypted String?  @db.Text
  secretEncrypted String?  @db.Text
  webhookSecret   String?  @db.Text
  logoUrl         String?
  minAmount       Decimal  @default(100.00) @db.Decimal(10, 2)
  maxAmount       Decimal  @default(100000.00) @db.Decimal(10, 2)
  isSandbox       Boolean  @default(true)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([isActive, displayOrder])
}

model DynamicApiConfig {
  id                 String    @id @default(uuid())
  providerKey        String    @unique
  name               String
  category           String
  baseUrl            String?
  apiKeyEncrypted    String?   @db.Text
  apiSecretEncrypted String?   @db.Text
  webhookSecret      String?   @db.Text
  isSandbox          Boolean   @default(true)
  isActive           Boolean   @default(true)
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastTestLatencyMs  Int?
  lastTestError      String?   @db.Text
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerKey])
  @@index([category])
}

